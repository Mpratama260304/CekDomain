# =============================================================================
# CekDomain.ink — LOCAL DEVELOPMENT configuration
# Copy to `.env.local`:  cp .env.local.example .env.local
# Uses the deterministic MOCK provider so the whole flow works offline.
# NEVER use mock in production.
# =============================================================================

# mock -> fake deterministic results for local demo/testing ONLY.
DOMAIN_CHECK_PROVIDER=mock
DOMAIN_CHECK_TIMEOUT_MS=3000

NEXT_PUBLIC_CHECKOUT_BASE_URL=https://marketku.id/domain/product/domain-murah-a82b6c2e-af2d-4c60-bfd7-1d33d2f71e04
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Suggestion tuning (optional; safe defaults used if unset).
SUGGESTION_CHECK_LIMIT=8
SUGGESTION_RETURN_LIMIT=6
SUGGESTION_CHECK_CONCURRENCY=3

# Rate limiting (optional; safe defaults used if unset).
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
