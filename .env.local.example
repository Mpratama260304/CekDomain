# =============================================================================
# CekDomain.ink — LOCAL DEVELOPMENT configuration
# Copy to `.env.local`:  cp .env.local.example .env.local
#
# Uses RDAP by default so you get REAL, key-less availability results in dev
# (this is what fixes false "registered" answers). No API keys required.
# =============================================================================

# rdap -> REAL best-effort lookups, no credentials needed. Great for dev.
DOMAIN_CHECK_PROVIDER=rdap
DOMAIN_CHECK_TIMEOUT_MS=5000

NEXT_PUBLIC_CHECKOUT_BASE_URL=https://marketku.id/domain/product/domain-murah-a82b6c2e-af2d-4c60-bfd7-1d33d2f71e04
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Suggestion tuning (optional).
SUGGESTION_CHECK_LIMIT=8
SUGGESTION_RETURN_LIMIT=6
SUGGESTION_CHECK_CONCURRENCY=3

# Rate limiting (roomier in dev so testing isn't blocked).
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# To test a REAL registrar API locally, set:
#   DOMAIN_CHECK_PROVIDER=registrar
#   REGISTRAR_API_PROVIDER=namecom            # or godaddy / generic
#   NAMECOM_USERNAME=...  NAMECOM_API_TOKEN=...  NAMECOM_ENV=test
#
# To use FAKE offline mock results (NOT accurate), you must opt in explicitly:
#   DOMAIN_CHECK_PROVIDER=mock
#   ALLOW_MOCK_PROVIDER=true
# -----------------------------------------------------------------------------
