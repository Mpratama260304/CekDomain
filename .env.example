# =============================================================================
# CekDomain.ink environment configuration
# Copy this file to `.env.local` and adjust values for your environment.
# =============================================================================

# Which availability provider to use on the server.
#   rdap  -> real, key-less lookups via the public RDAP protocol (production ready)
#   mock  -> deterministic local mock, for development/testing only
DOMAIN_CHECK_PROVIDER=rdap

# Max time (ms) to wait for a single upstream availability lookup before
# gracefully returning an "unknown" status instead of hanging the request.
DOMAIN_CHECK_TIMEOUT_MS=5000

# Public base URL the checkout button redirects to. The selected domain is
# appended as `?domain=<domain>`. Exposed to the client on purpose (NEXT_PUBLIC_).
NEXT_PUBLIC_CHECKOUT_BASE_URL=https://marketku.id/domain/product/domain-murah-a82b6c2e-af2d-4c60-bfd7-1d33d2f71e04

# Optional canonical site URL used for SEO metadata / Open Graph.
NEXT_PUBLIC_SITE_URL=https://cekdomain.ink

# -----------------------------------------------------------------------------
# Optional: paid/third-party availability API (used only if you build a
# dedicated provider for it). These are server-only secrets — never expose them
# with the NEXT_PUBLIC_ prefix.
# -----------------------------------------------------------------------------
# DOMAIN_API_URL=
# DOMAIN_API_KEY=
