# =============================================================================
# CekDomain.ink — PRODUCTION configuration
# Copy to `.env.local` and fill in real registrar credentials.
# For local development without credentials, use `.env.local.example` instead.
# =============================================================================

# Availability provider (server-side only). PRODUCTION MUST use `registrar`.
#   registrar -> REAL registrar/reseller API (authoritative source of truth)
#   rdap      -> best-effort RDAP only (fallback/secondary; can be inconclusive)
#   mock      -> FAKE results — DEV/TEST ONLY, forbidden in production
DOMAIN_CHECK_PROVIDER=registrar

# Which registrar adapter to use: generic | namecom | godaddy
REGISTRAR_API_PROVIDER=generic

# --- Generic adapter (e.g. a future Marketku API) ----------------------------
REGISTRAR_API_URL=
REGISTRAR_API_METHOD=GET
REGISTRAR_API_KEY=
REGISTRAR_API_SECRET=
REGISTRAR_API_USERNAME=
REGISTRAR_API_AUTH_HEADER=X-API-Key
REGISTRAR_API_DOMAIN_PARAM=domain
REGISTRAR_API_TIMEOUT_MS=8000

# --- Name.com adapter (REGISTRAR_API_PROVIDER=namecom) -----------------------
NAMECOM_USERNAME=
NAMECOM_API_TOKEN=
NAMECOM_ENV=production            # production | test (api.dev.name.com)

# --- GoDaddy adapter (REGISTRAR_API_PROVIDER=godaddy) ------------------------
GODADDY_API_KEY=
GODADDY_API_SECRET=
GODADDY_ENV=production            # production | ote (api.ote-godaddy.com)

# --- Safety flags (fail closed) ---------------------------------------------
# Allow RDAP-only as the provider in production (best-effort; may be unknown).
ALLOW_RDAP_ONLY_PRODUCTION=false
# Allow the FAKE mock provider. MUST stay false in production.
ALLOW_MOCK_PROVIDER=false

# General upstream timeout for RDAP fallback (ms).
DOMAIN_CHECK_TIMEOUT_MS=5000

# Public checkout base URL. The selected domain is appended as `?domain=<domain>`.
NEXT_PUBLIC_CHECKOUT_BASE_URL=https://marketku.id/domain/product/domain-murah-a82b6c2e-af2d-4c60-bfd7-1d33d2f71e04

# Canonical site URL used for SEO metadata / Open Graph.
NEXT_PUBLIC_SITE_URL=https://cekdomain.ink

# --- Suggestion tuning (safe defaults used if unset) ------------------------
SUGGESTION_CHECK_LIMIT=8
SUGGESTION_RETURN_LIMIT=6
SUGGESTION_CHECK_CONCURRENCY=3

# --- API rate limiting (in-memory, per IP) ----------------------------------
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
