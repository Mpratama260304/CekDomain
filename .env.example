# =============================================================================
# CekDomain.ink — PRODUCTION-like configuration
# Copy to `.env.local` for a prod-like setup. For local mock dev, use
# `.env.local.example` instead.
# =============================================================================

# Availability provider (server-side only):
#   rdap      -> REAL, key-less lookups via the public RDAP protocol (USE IN PRODUCTION)
#   mock      -> fake deterministic results, LOCAL DEV/TESTING ONLY — never in production
#   external  -> paid/third-party API (requires DOMAIN_API_URL + DOMAIN_API_KEY below)
DOMAIN_CHECK_PROVIDER=rdap

# Max time (ms) for a single upstream availability lookup before we return
# an "unknown" status instead of hanging the request.
DOMAIN_CHECK_TIMEOUT_MS=5000

# Public checkout base URL. The selected domain is appended as `?domain=<domain>`.
# Exposed to the client on purpose (NEXT_PUBLIC_).
NEXT_PUBLIC_CHECKOUT_BASE_URL=https://marketku.id/domain/product/domain-murah-a82b6c2e-af2d-4c60-bfd7-1d33d2f71e04

# Canonical site URL used for SEO metadata / Open Graph.
NEXT_PUBLIC_SITE_URL=https://cekdomain.ink

# -----------------------------------------------------------------------------
# Suggestion tuning (safe defaults are used if unset).
# -----------------------------------------------------------------------------
# Candidates actually verified upstream per registered-domain search.
SUGGESTION_CHECK_LIMIT=8
# Suggestions returned to the client (available first).
SUGGESTION_RETURN_LIMIT=6
# Parallel upstream checks for suggestions (keep low to avoid rate limits).
SUGGESTION_CHECK_CONCURRENCY=3

# -----------------------------------------------------------------------------
# API rate limiting (in-memory, per IP). Safe defaults used if unset.
# -----------------------------------------------------------------------------
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# Paid/third-party availability API — ONLY used when DOMAIN_CHECK_PROVIDER=external.
# Server-only secrets — never prefix these with NEXT_PUBLIC_.
# -----------------------------------------------------------------------------
# DOMAIN_API_URL=
# DOMAIN_API_KEY=
